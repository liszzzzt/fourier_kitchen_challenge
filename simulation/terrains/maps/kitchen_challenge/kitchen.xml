<?xml version='1.0' encoding='utf-8'?>
<mujoco model="kitchen">
  <!-- Asset declarations must be direct children of this terrain file.
       Fourier's viewer merges children of <asset>, but ignores top-level
       <include> elements while building main_with_terrain.xml. -->
  <asset>
    <!-- Dishwasher -->
    <mesh name="dw_ktc_dishwasher" file="../../../terrains/assets/meshes/ktc_dishwasher.stl" />
    <mesh name="dw_ktc_dishwasher_rack" file="../../../terrains/assets/meshes/ktc_dishwasher_rack.stl" />
    <mesh name="dw_ktc_dishwasher_door" file="../../../terrains/assets/meshes/ktc_dishwasher_door.stl" />
    <texture name="dw_T_Metal_bin" type="cube" height="1" width="1" file="../../../terrains/assets/textures/metal0.png" />
    <material name="dw_M_Metal_bin" texture="dw_T_Metal_bin" texrepeat="3 3" reflectance="0.7" texuniform="false" />

    <!-- Hinged cabinet -->
    <texture name="kc_T_hinge_wood" type="cube" height="1" width="1" file="../../../terrains/assets/textures/wood1.png" />
    <texture name="kc_T_hinge_metal" type="cube" height="1" width="1" file="../../../terrains/assets/textures/metal0.png" />
    <material name="kc_M_hinge_wood" texture="kc_T_hinge_wood" texrepeat="3 3" reflectance="0.7" shininess=".4" texuniform="false" />
    <material name="kc_M_hinge_metal" texture="kc_T_hinge_metal" texrepeat="3 3" reflectance="0.7" shininess=".4" texuniform="false" />
    <material name="kc_M_hinge_blue" texture="kc_T_hinge_wood" rgba="1 1 1 1" reflectance="0.7" shininess=".4" texuniform="false" />
    <material name="kc_hinge_collision_blue" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0" />

    <!-- Simple table -->
    <texture name="T_simpleWoodTable" type="cube" height="1" width="1" file="../../../terrains/assets/textures/wood1.png" />
    <material name="M_simpleWoodTable" texture="T_simpleWoodTable" rgba="0.8 0.8 0.8 1" shininess="0.2" reflectance="0.3" texuniform="false" />
    <texture name="T_simpleMarbleTable" type="cube" height="1" width="1" file="../../../terrains/assets/textures/stone0.png" />
    <material name="M_simpleMarbleTable" texture="T_simpleMarbleTable" rgba="0.75 0.75 0.75 1" shininess="1" reflectance="1" texuniform="false" />
    <texture name="T_simpleGraniteTable" type="cube" height="1" width="1" file="../../../terrains/assets/textures/stone1.png" />
    <material name="M_simpleGraniteTable" texture="T_simpleGraniteTable" rgba="0.75 0.75 0.75 1" shininess="1" reflectance="1" texuniform="false" />

    <!-- Bin -->
    <mesh name="bin" file="../../../terrains/assets/meshes/bin.stl" scale="0.01 0.01 0.01" />
    <mesh name="busbin" file="../../../terrains/assets/meshes/busbin.stl" />
    <texture name="T_Metal_bin" type="cube" height="1" width="1" file="../../../terrains/assets/textures/metal0.png" />
    <material name="M_Metal_bin" texture="T_Metal_bin" texrepeat="3 3" reflectance="0.7" texuniform="false" />
  </asset>
  <worldbody>
    <geom name="kitchen_wall_east" type="box" pos="3.05 0 1" size="0.05 3.1 1" rgba="0.85 0.85 0.8 1" contype="1" conaffinity="1" />
    <geom name="kitchen_wall_west" type="box" pos="-3.05 0 1" size="0.05 3.1 1" rgba="0.85 0.85 0.8 1" contype="1" conaffinity="1" />
    <geom name="kitchen_wall_north" type="box" pos="0 3.05 1" size="3 0.05 1" rgba="0.85 0.85 0.8 1" contype="1" conaffinity="1" />
    <geom name="kitchen_wall_south" type="box" pos="0 -3.05 1" size="3 0.05 1" rgba="0.85 0.85 0.8 1" contype="1" conaffinity="1" />
    <body name="kitchen_table" pos="0.2 -1 0">
      <include file="../../../terrains/components/simpleWoodTable_body.xml" />
    </body>
    <body name="kitchen_bin" pos="2 -1.4 0">
      <include file="../../../terrains/components/bin_body.xml" />
    </body>
    <body name="kitchen_cabinet" pos="-2 2.45 0.2">
      <include file="../../../terrains/components/hingecabinet_body.xml" />
    </body>
    <body name="kitchen_dishwasher" pos="2 2.75 0" quat="0 0 0 1">
      <include file="../../../terrains/components/dishwasher_body.xml" />
    </body>
  </worldbody>
</mujoco>
