<!-- Synthetic two-hinge test fixture, NOT Robotiq geometry or a grasp benchmark. -->
<mujoco model="gripper_transport_smoke_fixture">
  <compiler angle="radian"/>
  <default><joint armature="0.01"/></default>
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <body name="left" pos="0 -0.05 0">
      <joint name="rq_right_left_driver_joint" type="hinge" axis="0 0 1"
             limited="true" range="0 0.8" damping="0.1"/>
      <geom type="box" size="0.01 0.04 0.01" mass="0.1" contype="0" conaffinity="0"/>
    </body>
    <body name="right" pos="0 0.05 0">
      <joint name="rq_right_right_driver_joint" type="hinge" axis="0 0 -1"
             limited="true" range="0 0.8" damping="0.1"/>
      <geom type="box" size="0.01 0.04 0.01" mass="0.1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <equality><joint joint1="rq_right_right_driver_joint" joint2="rq_right_left_driver_joint"/></equality>
  <actuator>
    <general name="rq_right_fingers_actuator" joint="rq_right_left_driver_joint"
             ctrllimited="true" ctrlrange="0 255" forcelimited="true" forcerange="-5 5"
             gaintype="fixed" gainprm="0.04" biastype="affine" biasprm="0 -12.75 -1"/>
  </actuator>
</mujoco>
