<?xml version="1.0"?>
<package format="3">
  <name>gr3_gripper</name>
  <version>0.1.0</version>
  <description>ROS2 bridge for the simulation-only Robotiq gripper controller.</description>
  <maintainer email="noreply@github.com">Fourier kitchen challenge contributors</maintainer>
  <license>Unspecified</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- MuJoCo 2.3.6 is provided by the robot image; do not upgrade it via rosdep. -->
  <export><build_type>ament_python</build_type></export>
</package>
